# Copy to .env.local for personal overrides (git-ignored).
# Load order (first value wins): real environment variables > .env.local > .env.<TEST_ENV>
# Select the environment with TEST_ENV=dev|prod (defaults to dev).

# --- Web app under test (Sauce Demo) ---
BASE_URL=https://www.saucedemo.com
SAUCE_PASSWORD=secret_sauce

# --- API under test (Restful Booker) ---
API_URL=https://restful-booker.herokuapp.com
API_USERNAME=admin
API_PASSWORD=password123

# When false, tests that create/update/delete data are skipped (use for prod).
ALLOW_DATA_MUTATION=true
